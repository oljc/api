{
	"name": "api-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"scripts": {
		"dev": "edgeone makers dev --port 8088 --skip-env-sync --skip-ai-gateway-sync",
		"build": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"check:fix": "biome check --write",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"@neondatabase/serverless": "^1.1.0",
		"hash-wasm": "^4.12.0",
		"hono": "^4.13.8",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@edgeone/types": "^1.0.1",
		"@types/node": "^22.20.3",
		"edgeone": "^1.6.40",
		"lefthook": "^2.1.14",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=20 <21",
		"pnpm": ">=12"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
